{
  "rewrites": [
    {
      "source": "/privacy_policy",
      "destination": "/index.html"
    },
    {
      "source": "/cookie_policy",
      "destination": "/index.html"
    },
    {
      "source": "/post_details",
      "destination": "/api/og-event"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fixing": false
    }
  }
}