{
  "rewrites": [
    {
      "source": "/privacy_policy",
      "destination": "/index.html"
    },
    {
      "source": "/cookie_policy",
      "destination": "/index.html"
    },
    {
      "source": "/post_details",
      "destination": "/api/og-event",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|whatsapp|discordbot|slackbot|applebot|googlebot|bsky|Bluesky).*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fixing": false
    }
  }
}