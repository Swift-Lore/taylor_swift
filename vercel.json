{
  "rewrites": [
    {
      "source": "/privacy_policy",
      "destination": "/index.html"
    },
    {
      "source": "/cookie_policy",
      "destination": "/index.html"
    },
    {
      "source": "/post_details",
      "destination": "/api/og-event"
    },
    {
      "source": "/((?!images|assets|favicon\\.ico|.*\\.(png|jpg|jpeg|gif|svg|webp|css|js|json|txt|xml|ico)).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fixing": false
    }
  }
}